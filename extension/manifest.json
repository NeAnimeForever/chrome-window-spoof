{
  "manifest_version": 3,
  "name": "Chrome Window Spoof",
  "version": "3.0.0",
  "description": "Focus emulation for Chrome with JavaScript compatibility and native Blink modes.",
  "permissions": ["debugger", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "default_locale": "en",
  "action": {
    "default_title": "Chrome Window Spoof",
    "default_popup": "popup.html",
    "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}
  },
  "background": {"service_worker": "background.js"},
  "options_page": "settings.html",
  "minimum_chrome_version": "125",
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}
}
